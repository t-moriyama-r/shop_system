POSTGRES_USER=kojin_pos
POSTGRES_PASSWORD=kojin_pos
POSTGRES_DB=kojin_pos
POSTGRES_PORT=5432

DATABASE_URL=postgresql://kojin_pos:kojin_pos@localhost:5432/kojin_pos

# メール送信（EMAIL_PROVIDER=ses で AWS SES を使用。未設定時はコンソール出力のみの ConsoleEmailSender）
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
AWS_REGION=

# メール本文に記載するログインURLの生成元（未設定時は http://localhost:3000）
FRONTEND_ORIGIN=
